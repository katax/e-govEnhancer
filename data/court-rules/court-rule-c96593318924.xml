<?xml version="1.0" encoding="UTF-8"?>
<Law Era="" Year="" Num="" LawType="Rule" Lang="ja">
  <LawNum>昭和35年11月21日最高裁判所規則第１５号</LawNum>
  <LawBody>
    <LawTitle>道路交通法の施行に伴う交通事件の即決裁判に関する手続の経過措置に関する規則</LawTitle>
    <TOC/>
    <MainProvision>
      <Article Num="1">
        <ArticleTitle></ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum></ParagraphNum>
          <ParagraphSentence>
            <Sentence>道路交通法（昭和三十五年法律第百五号）附則第十八条第二項の規定により従前の例によるべき事件の即決裁判に関する手続については、交通事件即決裁判手続規則（昭和二十九年最高裁判所規則第十四号）の定めるところによる。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
      <SupplProvision>
        <SupplProvisionLabel>附則</SupplProvisionLabel>
        <Article Num="1">
          <ArticleTitle></ArticleTitle>
          <Paragraph Num="1">
            <ParagraphNum></ParagraphNum>
            <ParagraphSentence>
              <Sentence>この規則は、昭和三十五年十二月二十日から施行する。</Sentence>
            </ParagraphSentence>
          </Paragraph>
        </Article>
      </SupplProvision>
    </MainProvision>
  </LawBody>
</Law>
