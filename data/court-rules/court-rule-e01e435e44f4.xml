          <Paragraph Num="1">
            <ParagraphNum></ParagraphNum>
            <ParagraphSentence>
              <Sentence>第二項、第電子調書調書七十二条、第七十六条、第百十六条第三項、第百十八条第二項、第百二十二条の二第二項、第百二十二条の三第二項、第百四十二条及び第百四十六条第一項</Sentence>
            </ParagraphSentence>
          </Paragraph>
        </Article>
        <Article Num="47">
          <ArticleTitle>第四十七条</ArticleTitle>
          <Paragraph Num="1">
            <ParagraphNum></ParagraphNum>
            <ParagraphSentence>
              <Sentence>第一項及び第四書類又は電磁的記録書類十七条の二第二項</Sentence>
            </ParagraphSentence>
          </Paragraph>
        </Article>
        <Article Num="47_2">
          <ArticleTitle>第四十七条の二</ArticleTitle>
          <Paragraph Num="1">
