<?xml version="1.0" encoding="UTF-8"?>
<Law Era="Showa" Year="57" Num="15" LawType="Misc" Lang="ja">
  <LawNum>昭和五十七年六月十八日公正取引委員会告示第十五号</LawNum>
  <LawBody>
    <LawTitle>不公正な取引方法</LawTitle>
    <TOC>
      <TOCArticle><ArticleTitle>共同の取引拒絶</ArticleTitle><ArticleRange>第1条</ArticleRange></TOCArticle>
